# ============================================================
# 环境变量示例（复制为 .env.local 用于本地开发，.env.local 已被 gitignore）
# 在 GitHub Actions 中，这些变量应配置为 Repository Secrets
# ============================================================

# ---------- 画像服务（本地 FastAPI）----------
# 本地 FastAPI 画像服务地址，dev 模式下由 Vite 代理处理
# 生产环境（GitHub Pages）不可用，前端自动回退到 localStorage
VITE_PROFILE_API_BASE=/profile-api

# ---------- AI 教练应用配置（必须）----------
# 动知 AI 教练的应用 ID（在百炼/DashScope 控制台创建的应用 ID）
# 此值会内嵌到前端 JS 中，是公开信息
VITE_COACH_APP_ID=

# ---------- AI 教练 API 路径----------
# dev:  /coach-api          → Vite 代理到 DashScope（后端注入 Authorization）
# prod: https://your-worker.workers.dev  → Cloudflare Worker 代理到 DashScope
#       （Worker 在服务端注入 Authorization，前端无需暴露密钥）
VITE_COACH_API_BASE=/coach-api

# ---------- AI 教练 API 密钥（服务端专用）----------
# 此密钥绝对不要以 VITE_ 开头（防止被 Vite 内联到前端 JS）
# dev:  Vite 读取此变量并作为 proxy 的 Authorization header
# prod: 应放在 Cloudflare Worker 的 Secret 中，或通过 GitHub Secrets 传递
#        如果需要前端直连 DashScope（不推荐），请改用 VITE_COACH_API_KEY
COACH_API_KEY=

# ---------- AI 教练 API 目标地址----------
# dev: Vite 代理的目标地址（默认 DashScope 公共端点）
# prod: 仅在前端直连 DashScope 时使用（Worker 模式下不需要）
COACH_API_TARGET=https://dashscope.aliyuncs.com

# ---------- 生产环境直连备用（可选，不推荐）----------
# 如果不使用 Cloudflare Worker，而是让前端直连 DashScope：
# 1) 将 COACH_API_KEY 复制到 VITE_COACH_API_KEY
# 2) 将 VITE_COACH_API_BASE 改为 DashScope 的 API 基础地址
# 注意：这会把密钥暴露在浏览器中，仅限开发/演示使用
VITE_COACH_API_KEY=
VITE_COACH_API_TARGET=https://dashscope.aliyuncs.com
